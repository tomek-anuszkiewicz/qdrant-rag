# Persistent local data and index state. Keep these files when cleaning the workspace.
qdrant_storage/
*_rag_cache.json
rag_index.json

# Local configuration, secrets, and service process state.
.env
.env.*
service_config.local.json
*.pid

# Python bytecode and test caches. Regenerated when code or tests run.
__pycache__/
*.py[cod]
.pytest_cache/

